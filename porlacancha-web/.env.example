# porlacancha-web — pagos de reserva PorLaCancha (no mezclar con FulbitoYa)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de este sitio (webhook + back_urls). En local no se manda notification_url.
NEXT_PUBLIC_SITE_URL=https://tu-dominio-porlacancha-web.vercel.app

# Access Token de prueba de la app PorLaCancha en Mercado Pago (prefijo TEST- o APP_USR- de prueba).
# Preferir PLC_* para no pisar el token de FulbitoYa.
PLC_MERCADOPAGO_ACCESS_TOKEN=
# Fallback opcional:
# MERCADOPAGO_ACCESS_TOKEN=
